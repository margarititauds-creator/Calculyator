+import {makeStorage,storageConfigured} from './ydb-http.js';
+import {storedPayload} from './stored-payload.js';
+import {telegramRelay} from './telegram-relay.js';
+import {boundedJson} from './bounded-json.js';
+
+const enc=new TextEncoder();
+const gateway='https://d5dafk8hndmtgdf4nfio.3zvepvee.apigw.yandexcloud.net';
+const origins=new Set(['https://margarititavoronina.ru','https://voronina-revenue-calculator.fizzysheep2.chatgpt.site']);
+const uuid=value=>/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(value||'');
+const fixtureId='208f5d4b-968b-4f12-94fa-86528223d6b6';
+const json=(status,value)=>new Response(JSON.stringify(value),{status,headers:{'Content-Type':'application/json; charset=utf-8','Cache-Control':'no-store','X-Content-Type-Options':'nosniff'}});
+const privateError=()=>json(503,{status:'uncertain',message:'Подтверждение доставки временно недоступно. Заявку повторно отправлять не нужно.'});
+export function cloudOutboxConfigured(env){
+ return env.CLOUD_OUTBOX_ENABLED==='true'&&env.TELEGRAM_RELAY_ENABLED==='true'&&env.RF_INTAKE_ORIGIN===gateway
+  &&storageConfigured(env)&&/^[A-Za-z0-9+/]{43}=$/.test(env.DATA_KEY_BASE64||'')
+  &&/^[A-Za-z0-9_-]{43,}$/.test(env.TELEGRAM_RELAY_SECRET||'');
+}
+function report(lead,row){
+ if(lead.schema!=='calculator-current'||typeof lead.reportText!=='string'||typeof lead.name!=='string'||typeof lead.contact!=='string')throw Error('Stored report schema is unsupported');
+ const text=['Анкета — калькулятор Маргариты Ворониной',`Номер: ${row.id}`,`Время UTC: ${new Date(row.createdAt).toISOString()}`,
+  `Имя: ${lead.name}`,`${lead.contactType==='phone'?'Телефон':'Telegram'}: ${lead.contact}`,`Запрос: ${lead.question||'Не указан'}`,
+  ...Object.entries(lead.source||{}).map(([k,v])=>`${k}: ${v}`),`Согласие: ${lead.consent.version}`,'','Полный расчёт и рекомендации:',lead.reportText].join('\n');
+ if(enc.encode(text).length>65536)throw Error('Stored report is too large');
+ return text;
+}
+async function callRelay(env,payload,{send,clock}){
+ const stamp=String(Math.floor(clock()/1000)),body=JSON.stringify(payload);
+ const key=await crypto.subtle.importKey('raw',enc.encode(env.TELEGRAM_RELAY_SECRET),{name:'HMAC',hash:'SHA-256'},false,['sign']);
+ const signature=Array.from(new Uint8Array(await crypto.subtle.sign('HMAC',key,enc.encode(stamp+'\n'+body))),v=>v.toString(16).padStart(2,'0')).join('');
+ // Same existing relay implementation and bot; no extra network hop to Sites.
+ const response=await telegramRelay(new Request('https://voronina-revenue-calculator.fizzysheep2.chatgpt.site/internal/telegram-delivery',{
+  method:'POST',headers:{'Content-Type':'application/json','X-Calculator-Timestamp':stamp,'X-Calculator-Signature':signature},body}),env,{send,now:clock});
+ const value=await response.json();
+ if(!response.ok||value.ok!==true)throw Error('Telegram delivery is unconfirmed');
+ return value;
+}
+async function confirmedTelegram(env,row,lead,dependencies){
+ const value=await callRelay(env,{operation:'report',id:row.id,text:report(lead,row)},dependencies);
+ if(!Number.isSafeInteger(value.messageId)||value.messageId<=0)throw Error('Telegram delivery is unconfirmed');
+ return value.messageId;
+}
+export function cloudOutbox(env,{send=(...args)=>globalThis.fetch(...args),clock=Date.now,storage}={}){
+ const enabled=cloudOutboxConfigured(env);
+ const store=storage||(enabled?makeStorage(env,{send,clock}):null);
+ let prepared;
+ async function context(){
+  if(!enabled||!store)throw Error('Cloud delivery is disabled');
+  if(!prepared)prepared=(async()=>{
+   const box=await storedPayload(env.DATA_KEY_BASE64);
+   const [check,response]=await Promise.all([store.get('__key_check'),send(gateway+'/api/config',{redirect:'manual',signal:AbortSignal.timeout(6000)})]);
+   if(check?.fingerprint!==await box.digest('calculator-key-check-v1'))throw Error('Encryption key does not match the database');
+   if(!response.ok)throw Error('Current consent unavailable');
+   const config=await response.json();
+   if(!/^[a-f0-9]{64}$/.test(config.consentVersion||''))throw Error('Current consent unavailable');
+   return {box,version:config.consentVersion};
+  })();
+  return prepared;
+ }
+ async function deliver(id){
+  const {box,version}=await context(),now=Math.floor(clock()/1000),row=await store.claim(id,now);
+  if(!row)return 'pending';
+  try{
+   const lead=await box.decrypt(row);
+   if(lead.consent?.version!==version){await store.hold(row);return 'held';}
+   if(lead.schema!=='calculator-current'){await store.hold(row,'schema_review_required');return 'held';}
+   const messageId=await confirmedTelegram(env,row,lead,{send,clock});
+   if(!await store.sent(row,messageId))return 'pending';
+   return 'sent';
+  }catch{await store.retry(row,Math.floor(clock()/1000));return 'failed';}
+ }
+ const status=row=>row.state==='delivered'&&Number.isSafeInteger(row.messageId)&&row.messageId>0
+  ?json(200,{status:'sent',message:'Анкета и расчёт доставлены Маргарите Ворониной.'})
+  :row.state==='failed'?json(503,{status:'failed',message:'Анкета сохранена. Доставка требует повторной проверки; отправлять анкету заново не нужно.'})
+   :json(202,{status:'pending',message:'Анкета сохранена. Облачный отправитель повторит доставку автоматически.'});
+ return {
+  async health(){if(!enabled)return {configured:false};await context();await callRelay(env,{operation:'check'},{send,clock});return {configured:true,storage:true,consent:true,telegram:true};},
+  async visitor(request){
+   if(!enabled||env.CLOUD_OUTBOX_PUBLIC_ENABLED!=='true')return privateError();
+   if(request.method!=='POST')return json(405,{status:'unavailable'});
+   const origin=request.headers.get('origin');
+   if(!origins.has(origin)||new URL(request.url).origin!==origin)return json(403,{status:'unavailable'});
+   let payload;try{payload=await boundedJson(request,1024);}catch(code){return json(Number.isInteger(code)?code:400,{status:'unavailable'});}
+   if(!uuid(payload?.requestId)||!uuid(payload?.receipt)||Object.keys(payload).some(k=>!['requestId','receipt'].includes(k)))return json(400,{status:'unavailable'});
+   try{
+    const {box}=await context(),row=await store.get(payload.requestId),now=Math.floor(clock()/1000);
+    if(!row||row.expiresAt<=now||row.receiptHash!==await box.digest(payload.receipt))return json(404,{status:'uncertain',message:'Подтверждение сохранённой заявки не найдено.'});
+    if(row.state==='delivered'||row.state==='failed')return status(row);
+    if(!row.lease)await store.nudge(row.id,now);
+    await deliver(row.id);
+    return status(await store.get(row.id));
+   }catch{return privateError();}
+  },
+  async batch({recoverIds=[],syntheticOnly=false}={}){
+   if(!enabled)return {sent:0,confirmed:0,failed:0,held:0,pending:0,recovered:0,paused:true};
+   if(!Array.isArray(recoverIds)||recoverIds.length>5||!recoverIds.every(uuid))throw Error('Invalid recovery request');
+   const {box,version}=await context(),now=Math.floor(clock()/1000);
+   if(syntheticOnly){
+    const fixture=await store.get(fixtureId),data=fixture?.encrypted?await box.decrypt(fixture):null;
+    if(data?.name!=='Тестовая Анкета'||data?.contact!=='+70000000000'||!data?.question?.startsWith('ВЫМЫШЛЕННАЯ контрольная анкета для проверки запуска.'))throw Error('Authorized synthetic fixture unavailable');
+    if(fixture.state==='delivered'&&Number.isSafeInteger(fixture.messageId)&&fixture.messageId>0)return {sent:0,confirmed:1,failed:0,held:0,pending:0,recovered:0,paused:false};
+    recoverIds=[fixtureId];
+   }
+   let recovered=0;
+   for(const id of new Set(recoverIds)){
+    const row=await store.get(id);
+    if(!row||row.state!=='failed'||row.holdReason||row.lease||row.expiresAt<=now)continue;
+    const lead=await box.decrypt(row);
+    if(lead.consent?.version===version&&lead.schema==='calculator-current'&&await store.recover(row,now))recovered++;
+   }
+   const result={sent:0,confirmed:0,failed:0,held:0,pending:0,recovered,paused:false};
+   const candidates=syntheticOnly?[await store.get(fixtureId)]:await store.due(now);
+   for(const candidate of candidates.filter(Boolean))result[await deliver(candidate.id)]++;
+   return result;
+  }
+ };
+}
