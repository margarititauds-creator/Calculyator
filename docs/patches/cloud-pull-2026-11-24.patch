+// Browser-compatible transport for the existing Russian YDB Document API.
+// This module is server-only. It never logs credentials or database responses.
+const endpoint='https://docapi.serverless.yandexcloud.net/ru-central1/b1g3epmn03pu0rqo0h8a/etnbj7vjg6eudidvmb9o';
+const table='calculator_leads';
+const enc=new TextEncoder();
+const hex=bytes=>Array.from(new Uint8Array(bytes),x=>x.toString(16).padStart(2,'0')).join('');
+const sha=async text=>hex(await crypto.subtle.digest('SHA-256',enc.encode(text)));
+async function hmac(key,text){
+ const imported=await crypto.subtle.importKey('raw',typeof key==='string'?enc.encode(key):key,{name:'HMAC',hash:'SHA-256'},false,['sign']);
+ return new Uint8Array(await crypto.subtle.sign('HMAC',imported,enc.encode(text)));
+}
+export function storageConfigured(env){
+ return env.YDB_ENDPOINT===endpoint&&env.YDB_TABLE===table&&typeof env.YDB_ACCESS_KEY_ID==='string'&&env.YDB_ACCESS_KEY_ID.length>5
+  &&typeof env.YDB_SECRET_ACCESS_KEY==='string'&&env.YDB_SECRET_ACCESS_KEY.length>20;
+}
+export async function signedHeaders(env,operation,body,time=new Date()){
+ if(!storageConfigured(env)||!['GetItem','UpdateItem','Query','Scan'].includes(operation))throw Error('Storage configuration is incomplete');
+ const url=new URL(endpoint),stamp=time.toISOString().replace(/[:-]|\.\d{3}/g,''),day=stamp.slice(0,8);
+ const target='DynamoDB_20120810.'+operation,scope=day+'/ru-central1/dynamodb/aws4_request';
+ const canonicalHeaders=`content-type:application/x-amz-json-1.0\nhost:${url.host}\nx-amz-date:${stamp}\nx-amz-target:${target}\n`;
+ const names='content-type;host;x-amz-date;x-amz-target';
+ const canonical=['POST',url.pathname,'',canonicalHeaders,names,await sha(body)].join('\n');
+ const toSign=['AWS4-HMAC-SHA256',stamp,scope,await sha(canonical)].join('\n');
+ const signingKey=await hmac(await hmac(await hmac(await hmac('AWS4'+env.YDB_SECRET_ACCESS_KEY,day),'ru-central1'),'dynamodb'),'aws4_request');
+ const signature=hex(await hmac(signingKey,toSign));
+ return {'Content-Type':'application/x-amz-json-1.0','X-Amz-Date':stamp,'X-Amz-Target':target,
+  Authorization:`AWS4-HMAC-SHA256 Credential=${env.YDB_ACCESS_KEY_ID}/${scope}, SignedHeaders=${names}, Signature=${signature}`};
+}
+function pack(value){
+ if(typeof value==='string')return {S:value};
+ if(typeof value==='number'&&Number.isFinite(value))return {N:String(value)};
+ if(typeof value==='boolean')return {BOOL:value};
+ if(value===null)return {NULL:true};
+ if(Array.isArray(value))return {L:value.map(pack)};
+ if(value&&typeof value==='object')return {M:packMap(value)};
+ throw Error('Unsupported database value');
+}
+const packMap=values=>Object.fromEntries(Object.entries(values).map(([k,v])=>[k,pack(v)]));
+function unpack(value){
+ if('S' in value)return value.S;
+ if('N' in value)return Number(value.N);
+ if('BOOL' in value)return value.BOOL;
+ if('NULL' in value)return null;
+ if('L' in value)return value.L.map(unpack);
+ if('M' in value)return unpackMap(value.M);
+ throw Error('Unsupported database response');
+}
+const unpackMap=values=>values?Object.fromEntries(Object.entries(values).map(([k,v])=>[k,unpack(v)])):undefined;
+export function makeStorage(env,{send=(...args)=>globalThis.fetch(...args),clock=Date.now}={}){
+ if(!storageConfigured(env))throw Error('Storage configuration is incomplete');
+ async function call(operation,input){
+  const body=JSON.stringify({TableName:table,...input}),headers=await signedHeaders(env,operation,body,new Date(clock()));
+  const response=await send(endpoint,{method:'POST',headers,body,redirect:'manual',signal:AbortSignal.timeout(8000)});
+  if(response.status>=300&&response.status<400){await response.body?.cancel();throw Error('Database redirect rejected');}
+  const data=await response.json();
+  if(!response.ok){const failure=Error('Database request failed');if(/(?:^|#)ConditionalCheckFailedException$/.test(data.__type||''))failure.name='ConditionalCheckFailedException';throw failure;}
+  return data;
+ }
+ const conditional=async input=>{try{const row=unpackMap((await call('UpdateItem',input)).Attributes);if(!row)throw Error('Database acknowledgement is incomplete');return row;}catch(e){if(e.name==='ConditionalCheckFailedException')return null;throw e;}};
+ const update=(id,condition,expression,names,values)=>conditional({Key:packMap({id}),ConditionExpression:condition,UpdateExpression:expression,
+  ...(names&&{ExpressionAttributeNames:names}),ExpressionAttributeValues:packMap(values),ReturnValues:'ALL_NEW'});
+ return {
+  async get(id){return unpackMap((await call('GetItem',{Key:packMap({id}),ConsistentRead:true})).Item);},
+  async due(now){return ((await call('Query',{IndexName:'outbox',KeyConditionExpression:'#s = :queued AND dueAt <= :now',ExpressionAttributeNames:{'#s':'state'},ExpressionAttributeValues:packMap({':queued':'queued',':now':now}),Limit:5})).Items||[]).map(unpackMap);},
+  async claim(id,now){return update(id,'#s = :queued AND dueAt <= :now AND expiresAt > :now','SET dueAt = :until, lease = :lease, attempts = if_not_exists(attempts, :zero) + :one',{'#s':'state'},
+   {':queued':'queued',':now':now,':until':now+90,':lease':crypto.randomUUID(),':zero':0,':one':1});},
+  async sent(row,messageId){if(!Number.isSafeInteger(messageId)||messageId<=0)throw Error('Unconfirmed delivery');return !!await update(row.id,'lease = :lease','SET #s = :sent, messageId = :messageId REMOVE dueAt, lease',{'#s':'state'},{':lease':row.lease,':sent':'delivered',':messageId':messageId});},
+  async hold(row,reason='legal_review_required'){return update(row.id,'lease = :lease','SET #s = :state, holdReason = :reason REMOVE dueAt, lease',{'#s':'state'},{':lease':row.lease,':state':'failed',':reason':reason});},
+  async retry(row,now){const stop=row.attempts>=20;return update(row.id,'lease = :lease',stop?'SET #s = :state REMOVE dueAt, lease':'SET #s = :state, dueAt = :next REMOVE lease',{'#s':'state'},
+   {':lease':row.lease,':state':stop?'failed':'queued',...(!stop&&{':next':now+Math.min(3600,30*2**Math.min(row.attempts,7))})});},
+  async nudge(id,now){return update(id,'#s = :queued AND attribute_not_exists(lease) AND expiresAt > :now AND attempts < :limit','SET dueAt = :now',{'#s':'state'},{':queued':'queued',':now':now,':limit':20});},
+  // Recovery is private and bounded; consent is checked before this is called.
+  async recover(row,now){return update(row.id,'#s = :failed AND attribute_not_exists(holdReason) AND attribute_not_exists(lease) AND expiresAt > :now',
+   'SET #s = :queued, dueAt = :now, attempts = :zero',{'#s':'state'},{':failed':'failed',':queued':'queued',':now':now,':zero':0});}
+ };
+}
