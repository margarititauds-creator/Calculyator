+++ b/worker/delivery-mcp.js
@@ -0,0 +1,31 @@
+import {cloudOutbox} from './cloud-outbox.js';
+import {boundedJson} from './bounded-json.js';
+const tools=[
+ {name:'calculator_delivery_health',description:'Check the calculator cloud delivery connection without returning leads or credentials.',inputSchema:{type:'object',properties:{},additionalProperties:false},annotations:{readOnlyHint:true}},
+ {name:'verify_calculator_delivery',description:'Retry only the fixed fictitious launch-test record, after checking its fake contact and marker. Never delivers another lead.',inputSchema:{type:'object',properties:{},additionalProperties:false},annotations:{readOnlyHint:false}},
+ {name:'deliver_calculator_queue',description:'Deliver up to five saved calculator reports to the configured owner Telegram chat. Return counts only. Optional recovery IDs are for previously failed records with current consent.',
+  inputSchema:{type:'object',properties:{recoverIds:{type:'array',maxItems:5,items:{type:'string',format:'uuid'}}},additionalProperties:false},annotations:{readOnlyHint:false,idempotentHint:false}}
+];
+const reply=(status,value)=>new Response(JSON.stringify(value),{status,headers:{'Content-Type':'application/json','Cache-Control':'no-store'}});
+export async function deliveryMcp(request,env,{factory=cloudOutbox}={}){
+ if(request.method!=='POST')return reply(405,{error:'Method not allowed'});
+ let rpc;try{rpc=await boundedJson(request,4096);}catch(code){return reply(Number.isInteger(code)?code:400,{error:'Invalid request'});}
+ const id=typeof rpc?.id==='number'||typeof rpc?.id==='string'?rpc.id:null;
+ const result=value=>reply(200,{jsonrpc:'2.0',id,result:value});
+ const failure=(code,message)=>reply(200,{jsonrpc:'2.0',id,error:{code,message}});
+ if(rpc?.jsonrpc!=='2.0'||typeof rpc.method!=='string')return failure(-32600,'Invalid request');
+ if(rpc.method==='server/discover')return result({supportedVersions:['2026-07-28'],capabilities:{tools:{}}});
+ if(rpc.method==='tools/list')return result({tools});
+ if(rpc.method!=='tools/call')return failure(-32601,'Method not found');
+ // Sites authenticates /mcp and supplies these verified identity headers.
+ // Visibility of the public Site is not permission to operate its lead queue.
+ const owner=String(env.OUTBOX_OWNER_EMAIL||'').trim().toLowerCase();
+ if(!owner||!request.headers.get('oai-authenticated-user-id')||request.headers.get('oai-authenticated-user-email')?.trim().toLowerCase()!==owner)return reply(403,{error:'Owner access required'});
+ const name=rpc.params?.name,args=rpc.params?.arguments??{};
+ if(!args||typeof args!=='object'||Array.isArray(args)||Object.keys(args).some(k=>name!=='deliver_calculator_queue'||k!=='recoverIds'))return failure(-32602,'Invalid arguments');
+ if(!tools.some(t=>t.name===name))return failure(-32602,'Unknown tool');
+ try{
+  const queue=factory(env),value=name==='calculator_delivery_health'?await queue.health():await queue.batch(name==='verify_calculator_delivery'?{syntheticOnly:true}:args);
+  return result({content:[{type:'text',text:JSON.stringify(value)}],...(value.failed>0&&{isError:true})});
+ }catch{return result({content:[{type:'text',text:'Cloud delivery is unconfirmed; no contacts or credentials are included in this response.'}],isError:true});}
+}
