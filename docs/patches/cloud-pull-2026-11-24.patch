 import {telegramRelay,relayPath} from './telegram-relay.js';
+import {cloudOutbox} from './cloud-outbox.js';
+import {deliveryMcp} from './delivery-mcp.js';
 const assets=__ASSET_MANIFEST__;
 const headers={'X-Content-Type-Options':'nosniff','Referrer-Policy':'no-referrer','Content-Security-Policy':"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'self'"};
 export default {async fetch(request,env){
  const endpoint=intakeOrigin(env);
