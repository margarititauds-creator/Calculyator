+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createDeliveryClient} from '../web/delivery-client.js';
+const gateway='https://d5dafk8hndmtgdf4nfio.3zvepvee.apigw.yandexcloud.net';
+const body={requestId:'208f5d4b-968b-4f12-94fa-86528223d6b6',receipt:'11111111-2222-4333-8444-555555555555',name:'Вымышленный контакт',contact:'+70000000000',calculation:{revenue:300000}};
+function setup({enabled=true,failDelivery=false,intake='pending'}={}){
+ const calls=[];
+ const client=createDeliveryClient(async(url,options)=>{
+  calls.push({url,options});
+  if(url==='/api/config')return Response.json({intakeOrigin:gateway,cloudDeliveryEnabled:enabled});
+  if(url===gateway+'/api/config')return Response.json({ready:true,consentVersion:'a'.repeat(64)});
+  if(url===gateway+'/api/submit'||url===gateway+'/api/status')return Response.json({status:intake},{status:intake==='pending'?202:400});
+  if(url==='/api/deliver'){if(failDelivery)throw Error('Network failure');return Response.json({status:'sent'});}
+  throw Error('Unexpected URL');
+ });
+ return {client,calls};
+}
+test('personal data goes to the Russian intake before opaque delivery identifiers reach Sites',async()=>{
+ const {client,calls}=setup();await client.config();
+ const response=await client.post('/api/submit',body);assert.equal((await response.json()).status,'sent');
+ assert.equal(calls[2].url,gateway+'/api/submit');assert.deepEqual(JSON.parse(calls[2].options.body),body);
+ assert.equal(calls[3].url,'/api/deliver');assert.deepEqual(JSON.parse(calls[3].options.body),{requestId:body.requestId,receipt:body.receipt});
+ assert.equal(calls[3].options.credentials,'omit');assert.doesNotMatch(calls[3].options.body,/70000000000|300000|contact|name/);
+});
+test('disabled, rejected or unreachable cloud delivery never replaces a storage receipt with false success',async()=>{
+ for(const settings of [{enabled:false},{failDelivery:true},{intake:'invalid'}]){
+  const {client,calls}=setup(settings);await client.config();const result=await (await client.post('/api/submit',body)).json();
+  assert.notEqual(result.status,'sent');if(settings.enabled===false||settings.intake==='invalid')assert.equal(calls.length,3);
+ }
+});
