+++ b/worker/stored-payload.js
@@ -0,0 +1,23 @@
+const enc=new TextEncoder(),dec=new TextDecoder('utf-8',{fatal:true});
+const from64=text=>Uint8Array.from(atob(text),c=>c.charCodeAt(0));
+const hex=buffer=>Array.from(new Uint8Array(buffer),x=>x.toString(16).padStart(2,'0')).join('');
+export async function storedPayload(encoded){
+ if(!/^[A-Za-z0-9+/]{43}=$/.test(encoded||''))throw Error('Invalid encryption configuration');
+ const raw=from64(encoded);
+ if(raw.length!==32)throw Error('Invalid encryption configuration');
+ const key=await crypto.subtle.importKey('raw',raw,'AES-GCM',false,['decrypt']);
+ const hkdf=await crypto.subtle.importKey('raw',raw,'HKDF',false,['deriveKey']);
+ const mac=await crypto.subtle.deriveKey({name:'HKDF',hash:'SHA-256',salt:new Uint8Array(),info:enc.encode('calculator-hmac-v1')},hkdf,{name:'HMAC',hash:'SHA-256',length:256},false,['sign']);
+ return {
+  async digest(text){return hex(await crypto.subtle.sign('HMAC',mac,enc.encode(text)));},
+  async decrypt(row){
+   if(typeof row?.encrypted!=='string'||row.encrypted.length>180000)throw Error('Invalid stored payload');
+   const bytes=from64(row.encrypted);if(bytes.length<29)throw Error('Invalid stored payload');
+   // Existing Node format: 12-byte nonce, 16-byte tag, ciphertext.
+   // WebCrypto expects ciphertext followed by the tag.
+   const combined=new Uint8Array(bytes.length-12);combined.set(bytes.subarray(28));combined.set(bytes.subarray(12,28),bytes.length-28);
+   const result=await crypto.subtle.decrypt({name:'AES-GCM',iv:bytes.subarray(0,12),tagLength:128,additionalData:enc.encode(`calculator-v1:${row.id}:${row.expiresAt}`)},key,combined);
+   return JSON.parse(dec.decode(result));
+  }
+ };
+}
