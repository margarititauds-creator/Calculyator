@@ -0,0 +1,29 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createHmac} from 'node:crypto';
+import {deliveryCheck,checkPath} from '../worker/delivery-check.js';
+const secret='x'.repeat(43),time=1795530000000;
+function request(body={operation:'synthetic'},{stamp=String(time/1000),path=checkPath,key=secret}={}){
+ const raw=typeof body==='string'?body:JSON.stringify(body);
+ const signature=createHmac('sha256',key).update(path+'\n'+stamp+'\n'+raw).digest('hex');
+ return new Request('https://example.test'+checkPath,{method:'POST',headers:{'Content-Type':'application/json','X-Calculator-Timestamp':stamp,'X-Calculator-Signature':signature},body:raw});
+}
+test('signed maintenance verification only invokes the fixed synthetic check',async()=>{
+ let called=0;const factory=()=>({batch:async args=>{assert.deepEqual(args,{syntheticOnly:true});called++;return {sent:1,failed:0};}});
+ const result=await deliveryCheck(request(),{TELEGRAM_RELAY_SECRET:secret},{factory,clock:()=>time});
+ assert.equal(result.status,200);assert.equal((await result.json()).ok,true);assert.equal(called,1);
+ for(const body of [{operation:'queue'},{operation:'synthetic',recoverIds:['other']},{operation:'report'}])assert.equal((await deliveryCheck(request(body),{TELEGRAM_RELAY_SECRET:secret},{factory,clock:()=>time})).status,400);
+ assert.equal(called,1);
+});
+test('forged, stale, cross-path, malformed and oversized checks cannot access the backend',async()=>{
+ const factory=()=>{throw Error('Must not access backend');},env={TELEGRAM_RELAY_SECRET:secret},deps={factory,clock:()=>time};
+ for(const options of [{key:'wrong'},{stamp:String(time/1000-121)},{path:'/internal/telegram-delivery'}])assert.equal((await deliveryCheck(request(undefined,options),env,deps)).status,403);
+ assert.equal((await deliveryCheck(request('x'.repeat(513)),env,deps)).status,413);
+ assert.equal((await deliveryCheck(request('{'),env,deps)).status,400);
+});
+test('unconfirmed maintenance results never report success',async()=>{
+ for(const result of [{paused:true,sent:0,failed:0},{sent:0,failed:1},{sent:0,failed:0,pending:1}]){
+  const response=await deliveryCheck(request(),{TELEGRAM_RELAY_SECRET:secret},{factory:()=>({batch:async()=>result}),clock:()=>time});
+  assert.equal(response.status,503);assert.equal((await response.json()).ok,false);
+ }
+});
