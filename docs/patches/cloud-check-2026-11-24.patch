diff --git a/worker/delivery-check.js b/worker/delivery-check.js
new file mode 100644
index 0000000..26c237f
--- /dev/null
+++ b/worker/delivery-check.js
@@ -0,0 +1,27 @@
+import {boundedText} from './bounded-json.js';
+import {cloudOutbox} from './cloud-outbox.js';
+const enc=new TextEncoder();
+export const checkPath='/internal/calculator-cloud-check';
+const reply=(status,value)=>new Response(JSON.stringify(value),{status,headers:{'Content-Type':'application/json','Cache-Control':'no-store','X-Content-Type-Options':'nosniff'}});
+// This maintenance route can only check connectivity or the fixed fake fixture.
+// It cannot select real records, enumerate the outbox, or enable public delivery.
+export async function deliveryCheck(request,env,{factory=cloudOutbox,clock=Date.now}={}){
+ if(new URL(request.url).pathname!==checkPath)return reply(404,{ok:false});
+ if(request.method!=='POST')return reply(405,{ok:false});
+ if(!/^[A-Za-z0-9_-]{43,}$/.test(env.TELEGRAM_RELAY_SECRET||''))return reply(503,{ok:false});
+ const stamp=request.headers.get('x-calculator-timestamp')||'',signature=request.headers.get('x-calculator-signature')||'';
+ if(!/^\d{10}$/.test(stamp)||Math.abs(Math.floor(clock()/1000)-Number(stamp))>120||!/^[a-f0-9]{64}$/.test(signature))return reply(403,{ok:false});
+ let raw;try{raw=await boundedText(request,512);}catch(status){return reply(Number.isInteger(status)?status:400,{ok:false});}
+ const key=await crypto.subtle.importKey('raw',enc.encode(env.TELEGRAM_RELAY_SECRET),{name:'HMAC',hash:'SHA-256'},false,['verify']);
+ const bytes=Uint8Array.from(signature.match(/../g),v=>parseInt(v,16));
+ // Bind this signature to the exact maintenance path as well as timestamp/body.
+ if(!await crypto.subtle.verify('HMAC',key,bytes,enc.encode(checkPath+'\n'+stamp+'\n'+raw)))return reply(403,{ok:false});
+ let body;try{body=JSON.parse(raw);}catch{return reply(400,{ok:false});}
+ if(!body||Object.keys(body).length!==1||!['health','synthetic'].includes(body.operation))return reply(400,{ok:false});
+ try{
+  const queue=factory(env),result=body.operation==='health'?await queue.health():await queue.batch({syntheticOnly:true});
+  const ok=body.operation==='health'?result.configured===true&&result.storage===true&&result.consent===true&&result.telegram===true
+   :result.failed===0&&(result.sent===1||result.confirmed===1);
+  return reply(ok?200:503,{ok,result});
+ }catch{return reply(503,{ok:false,message:'Cloud verification is unconfirmed'});}
+}
