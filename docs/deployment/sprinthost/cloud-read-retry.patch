diff --git a/test/cloud-outbox.test.mjs b/test/cloud-outbox.test.mjs
index efa9b04..e7f3f4f 100644
--- a/test/cloud-outbox.test.mjs
+++ b/test/cloud-outbox.test.mjs
@@ -165,3 +165,34 @@ test('oversize bodies are rejected before touching storage or Telegram',async()=
  const f=fixture();const response=await f.queue.visitor(new Request(origin+'/api/deliver',{method:'POST',headers:{Origin:origin,'Content-Type':'application/json'},body:'x'.repeat(1025)}));
  assert.equal(response.status,413);assert.equal(f.sent.length,0);
 });
+
+test('a transient database read timeout or service outage gets one bounded retry',async()=>{
+ for(const operation of ['get','due']){
+  for(const failure of ['timeout','http']){
+   let calls=0;
+   const store=makeStorage(env,{clock:()=>time,send:async()=>{
+    if(++calls===1){if(failure==='timeout')throw new DOMException('Timed out','TimeoutError');return new Response('temporarily unavailable',{status:503});}
+    return Response.json(operation==='get'?{Item:{id:{S:id}}}:{Items:[{id:{S:id}}]});
+   }});
+   const value=operation==='get'?await store.get(id):await store.due(seconds);
+   assert.equal(operation==='get'?value.id:value[0].id,id);assert.equal(calls,2);
+  }
+ }
+});
+
+test('persistent read failures stop after two calls and authorization failures are not retried',async()=>{
+ for(const status of [503,403]){
+  let calls=0;const store=makeStorage(env,{send:async()=>{calls++;return Response.json({__type:'AccessDeniedException'},{status});}});
+  await assert.rejects(()=>store.get(id));assert.equal(calls,status===503?2:1);
+ }
+});
+
+test('uncertain database writes are never replayed automatically',async()=>{
+ for(const operation of ['claim','sent']){
+  for(const failure of ['timeout','http']){
+   let calls=0;const store=makeStorage(env,{send:async()=>{calls++;if(failure==='timeout')throw new DOMException('Timed out','TimeoutError');return new Response(null,{status:503});}});
+   await assert.rejects(()=>operation==='claim'?store.claim(id,seconds):store.sent({id,lease:'fixture-lease'},42));
+   assert.equal(calls,1);
+  }
+ }
+});
